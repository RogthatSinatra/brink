<div id="festival-list">
    <div id="festival_hero">
        <h1>The Brink Events Guide 2026 [Kampala]</h1>
    </div>
    <div class="months-wrapper">
        <div class="months swiper swiper-initialized swiper-horizontal">
            <div class="swiper-wrapper" id="months" aria-live="polite">
                {{#each eventsByYear}}
                 {{#each months}}
                <div class="swiper-slide {{#ifCond @index '===' 0}}swiper-slide-active{{/ifCond}}" role="group" aria-label="{{add @index 1}} / {{months.length}}" style="width: 855px;"><a href="#{{month}}{{...year}}">{{month}}</a></div>
                {{/each}}
                {{/each}}
            </div>
            <div class="swiper-button-prev swiper-button-disabled" tabindex="-1" role="button" aria-label="Previous slide" aria-controls="months" aria-disabled="true"></div>
            <div class="swiper-button-next" tabindex="0" role="button" aria-label="Next slide" aria-controls="months" aria-disabled="false"></div>
            <span class="swiper-notification" aria-live="assertive" aria-atomic="true"></span>
        </div>
    </div>
    <div class="festivals">
    	{{#each eventsByYear}}
                 {{#each months}}
        <div id="{{month}}{{...year}}" class="monthHeader">{{#ifCond month '===' 'December'}}Dirty{{/ifCond}} {{month}}</div>
{{#each events}}
{{#if recommend}}

