<script src="/js/swiper-bundle.min.js"></script>
                <script>
                const swiper = new Swiper('.swiper', {
                    navigation: {
                        allowTouchMove: false,
                        nextEl: '.swiper-button-next',
                        prevEl: '.swiper-button-prev',
                    },
                    breakpoints: {
                        900: {
                            enabled: false
                        }
                    }

                });

                swiper.on('slideChange', function() {
                    const EL_currentSlide = this.slides[this.activeIndex].children[0].href;
                    if (history.pushState) {
                        history.pushState(null, null, EL_currentSlide);
                    } else {
                        location.hash = EL_currentSlide;
                    }
                });

                swiper.on('navigationNext', function() {
                    const EL_currentSlide = this.slides[this.activeIndex].children[0].href;
                    window.location.href = EL_currentSlide;
                });

                swiper.on('navigationPrev', function() {
                    const EL_currentSlide = this.slides[this.activeIndex].children[0].href;
                    window.location.href = EL_currentSlide;
                });

                var btns = document.getElementsByClassName("swiper-slide");

                // Loop through the buttons and add the active class to the current/clicked button
                for (var i = 0; i < btns.length; i++) {
                    btns[i].addEventListener("click", function() {
                        var current = document.getElementsByClassName("swiper-slide-active");
                        current[0].className = current[0].className.replace(" swiper-slide-active", "");
                        this.className += " swiper-slide-active";
                    });
                }

                let observerOptions = {
                    rootMargin: '0px 0px -80%',
                    threshold: 0
                }

                var observer = new IntersectionObserver(observerCallback, observerOptions);

                function observerCallback(entries, observer) {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            var current = document.getElementsByClassName("swiper-slide-active");
                            current[0].className = current[0].className.replace(" swiper-slide-active", "");
                            var anchor = entry.target.id;
                            var months = document.getElementById("months");
                            var activeMonth = months.querySelector("a[href='#" + anchor + "']");
                            activeMonth.parentElement.classList.add("swiper-slide-active");

                            var pos = Array.prototype.slice.call(document.getElementsByClassName('swiper-slide'))
                                .indexOf(document.getElementsByClassName('swiper-slide-active')[0]);

                            if (history.pushState) {
                                history.pushState(null, null, activeMonth);
                            } else {
                                location.hash = activeMonth;
                            }



                            swiper.slideTo(pos);
                        }
                    });
                };

                let target = '.monthHeader';
                document.querySelectorAll(target).forEach((i) => {
                    if (i) {
                        observer.observe(i);
                    }
                });

                window.onload = function() {

                    const months = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
                    const d = new Date();
                    let month = months[d.getMonth()];
                    let year = d.getFullYear();
                    let anchor = month + year;
                    // console.log(anchor);
                    document.getElementById(anchor).scrollIntoView();
                };



                const myTimeout = setTimeout(myGreeting, 2000);

                function myGreeting() {
                    document.getElementById("supportUsBubble").click();
                }
                </script>
